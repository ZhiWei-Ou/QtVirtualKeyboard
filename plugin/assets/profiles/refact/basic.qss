QFrame[flag="root"] {
    background-color: #000000;
}

QPushButton[style="basic"] {
    border: 1px solid transparent;
    border-radius: 5px;
    background-color: #2c2b29;
    color: #ffffff;
    font-size: 18px;
    icon-size: 28px;
}

QPushButton[key="backspace"], QPushButton[key="shift"], QPushButton[key="enter"],
QPushButton[key="symbol"], QPushButton[key="hide"]
{
    background-color: #151212;
}

QPushButton:pressed {
    background-color: gray;
}


QPushButton[key="space"]
{
    color: #868482;
}

QPushButton[key="spacer"] {
    border: 1px solid transparent;
    background-color: transparent;
}
